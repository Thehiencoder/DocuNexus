# ==============================================================================
# DocuNexus Configuration Template
# Copy this file to .env and fill in your API credentials.
# ==============================================================================

# Application Settings
PROJECT_NAME="DocuNexus"
API_V1_STR="/api/v1"
DEBUG=True

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=docunexus_knowledge_base
# If using Qdrant Cloud (optional):
# QDRANT_URL=
# QDRANT_API_KEY=

# Embedding Model Configuration
# Options:
# - gemini: models/text-embedding-004 (dim: 768, free tier via Google AI Studio)
# - huggingface: BAAI/bge-small-en-v1.5 (dim: 384, 100% free & local)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIM=768

# Generation LLM Configuration (Google Gemini - Free Tier Available)
# Options: gemini-3.5-flash, gemini-2.5-flash, gemini-1.5-flash
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Cohere Rerank Configuration (Free trial key available at cohere.com)
COHERE_API_KEY=your_cohere_api_key_here
COHERE_RERANK_MODEL=rerank-v3.5
COHERE_TOP_N=5

# Document Storage & Ingestion
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=512
CHUNK_OVERLAP=50
